# --- MiniMax API (OpenAI-compatible) ---
MINIMAX_API_KEY=your_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5

# --- CLI -> backend sync (leave blank to disable) ---
SYNC_URL=
SYNC_TOKEN=

# --- Backend (Render) ---
# Postgres URL for durable storage; blank = SQLite in data/ (fine locally,
# WIPED on free-tier redeploys — use the Supabase session-pooler URI in prod).
DATABASE_URL=
# Comma-separated allowed origins for the browser app; blank = allow all.
# e.g. CORS_ORIGINS=https://summer-quest.vercel.app,http://localhost:5173
CORS_ORIGINS=

# --- Session tuning (optional) ---
QUESTIONS_PER_SESSION=10
LA_RATIO=0.7
